{
  "name": "@carepath/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "root=$(pwd) && tmp=$(mktemp -d) && cd \"$tmp\" && npx -y -p openapi-typescript@7.13.0 -p typescript@5.9.3 openapi-typescript \"$root/../../packages/contracts/openapi/carepath.yaml\" -o \"$root/src/api/schema.d.ts\"; status=$?; rm -rf \"$tmp\"; exit $status"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "1.170.38",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.40",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "oxlint": "^1.83.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  }
}
