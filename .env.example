POSTGRES_DB=carepath
POSTGRES_USER=carepath
POSTGRES_PASSWORD=carepath
POSTGRES_PORT=5432
# Only used by `make api`/`make start` (native go run against a local
# postgres); docker-compose connects its own containers via the "postgres"
# service hostname regardless of this value.
POSTGRES_HOST=localhost
CAREPATH_API_PORT=8080
MOCK_HIS_PORT=8090
# docker-compose.prod.yml only: the nginx edge port (web + /api, one origin)
CAREPATH_EDGE_PORT=80
# Empty = same-origin: the browser calls the Vite server, whose /api proxy
# (vite.config.ts) forwards to the API — one origin, one ngrok tunnel when
# testing on a phone. Set only to reach an API on a different origin.
VITE_API_BASE_URL=
# Where the Vite dev-server /api proxy forwards. docker-compose sets this to
# the api service hostname; native `make web` ignores it (root .env isn't
# loaded there) and uses localhost:8080 instead.
API_PROXY_TARGET=http://api:8080
# LIFF entry is disabled for now (patients open the app via the printed
# navigation-slip link instead). Set to `line` + a real VITE_LIFF_ID to
# re-enable (see apps/web/src/auth/AuthProvider.tsx).
VITE_AUTH_MODE=demo
VITE_LIFF_ID=
HIS_BASE_URL=http://mock-his:8090
# Base URL mock-his's console links to for "open patient view" (VN link
# stand-in for the real printed navigation-slip QR). Empty = relative
# (correct behind docker-compose.prod.yml's single-origin proxy);
# docker-compose.yml defaults it to the dev web server.
PATIENT_APP_BASE_URL=
# How often the API polls the HIS event feed (Go duration)
HIS_INGEST_INTERVAL=5s
# LINE Login channel ID (aud claim) for verifying LIFF ID tokens; leave unset
# to run without real LINE login (source=demo still works via ALLOW_DEMO_AUTH)
LINE_CHANNEL_ID=
# Accept source=demo on POST /api/v1/auth/session — keep false outside local dev
# (this file targets the compose demo machine; see ADR-0011 deploy checklist)
ALLOW_DEMO_AUTH=true
# Patient session lifetime (Go duration)
SESSION_TTL=24h
# Visit share-link lifetime (Go duration, ADR-0011) — how long a relative's
# tracking link keeps working before it must be re-shared
SHARE_LINK_TTL=4h
# Staff/admin auth (ADR-0010). Leave JWT_SECRET unset only in local dev — the
# API then boots with a random key (tokens die on restart) and logs a warning.
JWT_SECRET=
# Staff access-token lifetime (Go duration)
ACCESS_TOKEN_TTL=15m
# Staff refresh-token lifetime (Go duration)
REFRESH_TOKEN_TTL=168h
# Timezone for the analytics "today" window (#86) — midnight boundaries are
# resolved in this zone. The API embeds tzdata, so any IANA name works.
ANALYTICS_TIMEZONE=Asia/Bangkok
