POSTGRES_DB=carepath
POSTGRES_USER=carepath
POSTGRES_PASSWORD=carepath
POSTGRES_PORT=5432
# Only used by `make api`/`make start` (native go run against a local
# postgres); docker-compose connects its own containers via the "postgres"
# service hostname regardless of this value.
POSTGRES_HOST=localhost
CAREPATH_API_PORT=8080
MOCK_HIS_PORT=8090
VITE_API_BASE_URL=http://localhost:8080
HIS_BASE_URL=http://mock-his:8090
# How often the API polls the HIS event feed (Go duration)
HIS_INGEST_INTERVAL=5s
# LINE Login channel ID (aud claim) for verifying LIFF ID tokens; leave unset
# to run without real LINE login (source=demo still works via ALLOW_DEMO_AUTH)
LINE_CHANNEL_ID=
# Accept source=demo on POST /api/v1/auth/session — keep false outside local dev
ALLOW_DEMO_AUTH=false
# Patient session lifetime (Go duration)
SESSION_TTL=24h
# Staff/admin auth (ADR-0010). Leave JWT_SECRET unset only in local dev — the
# API then boots with a random key (tokens die on restart) and logs a warning.
JWT_SECRET=
# Staff access-token lifetime (Go duration)
ACCESS_TOKEN_TTL=15m
# Staff refresh-token lifetime (Go duration)
REFRESH_TOKEN_TTL=168h
